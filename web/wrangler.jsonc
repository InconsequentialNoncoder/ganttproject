{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganttproject-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_DO", "class_name": "ProjectDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectDO"] }],
  "routes": [{ "pattern": "gantt.inconsequentialnoncoder.co.uk", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ganttproject",
      "database_id": "21fd62ce-8770-4404-8e48-0db0a7484cfe"
    }
  ],
  "vars": {
    // Local-dev default only. Set a real secret for production:
    // `wrangler secret put SESSION_SECRET`.
    "SESSION_SECRET": "dev-insecure-session-secret"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
